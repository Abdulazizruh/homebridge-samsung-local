{
  "name": "homebridge-samsung-local",
  "displayName": "Samsung Local",
  "version": "1.4.0-beta.32",
  "description": "Local, cloud-free control of Samsung appliances over your home network: air conditioners, washer status with a cycle-finished sensor, and Tizen TVs. Automatic network scan finds and identifies your appliances. No SmartThings API subscription, no Home Assistant, no Python required.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Abdulazizruh",
  "homepage": "https://github.com/Abdulazizruh/homebridge-samsung-local#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdulazizruh/homebridge-samsung-local.git"
  },
  "bugs": {
    "url": "https://github.com/Abdulazizruh/homebridge-samsung-local/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "samsung",
    "smartthings",
    "local",
    "air-conditioner",
    "windfree",
    "ocf",
    "no-cloud"
  ],
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "index.js",
    "src",
    "python/bridge.py",
    "python/requirements.txt",
    "python/requirements.lock",
    "engine",
    "homebridge-ui",
    "assets/icon.svg",
    "assets/icon.png",
    "config.schema.json",
    "CHANGELOG.md",
    "README.ar.md",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "test:python": "python3 -m unittest discover -s test/python -v",
    "check": "node scripts/check-syntax.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@homebridge/ciao": "^1.4.0",
    "@homebridge/plugin-ui-utils": "^2.3.0",
    "@peculiar/x509": "^1.14.3",
    "bplist-creator": "^0.4.0",
    "bplist-parser": "^0.6.0",
    "cbor-x": "^1.6.9",
    "fast-srp-hap": "^2.0.4",
    "qrcode-svg": "^1.1.0",
    "werift-dtls": "^0.5.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "homebridge": "^2.5.0"
  }
}
