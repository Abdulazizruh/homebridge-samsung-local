{
  "pluginAlias": "SamsungLocal",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Local control of Samsung appliances. Use the form above to add an appliance by IP address and discover what it supports.",
  "footerDisplay": "Unofficial project, not affiliated with Samsung. Run this plugin as a child bridge.",
  "schema": {
    "type": "object",
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Samsung Local"
      },
      "devices": {
        "title": "Appliances",
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "title": "IP address",
              "type": "string",
              "placeholder": "192.168.1.50"
            },
            "name": {
              "title": "Name (optional)",
              "type": "string",
              "description": "Shown in HomeKit exactly as typed."
            },
            "id": {
              "title": "Device ID (filled by discovery)",
              "type": "string",
              "description": "Stable ID read from the appliance. Keeps one accessory when the IP address changes. Do not edit."
            },
            "mac": {
              "title": "MAC address (filled by discovery)",
              "type": "string",
              "description": "Used to find the appliance again if its IP address changes."
            },
            "enabled": {
              "title": "Enabled",
              "type": "boolean",
              "default": true
            },
            "features": {
              "title": "Shown in HomeKit",
              "type": "object",
              "properties": {
                "fan": {
                  "title": "Fan tile (speed slider, Auto, swing)",
                  "type": "boolean",
                  "default": true
                },
                "fanAutoSwitch": {
                  "title": "Fan Auto switch",
                  "type": "boolean",
                  "default": true
                },
                "fanTurboSwitch": {
                  "title": "Turbo switch",
                  "type": "boolean",
                  "default": true
                },
                "fanSpeedSwitches": {
                  "title": "Low / Medium / High switches",
                  "type": "boolean",
                  "default": false
                },
                "drySwitch": {
                  "title": "Dry mode switch",
                  "type": "boolean",
                  "default": true
                },
                "fanOnlySwitch": {
                  "title": "Fan Only mode switch",
                  "type": "boolean",
                  "default": true
                },
                "windFree": {
                  "title": "WindFree switch",
                  "type": "boolean",
                  "default": true
                },
                "fast": {
                  "title": "Fast switch",
                  "type": "boolean",
                  "default": true
                },
                "quiet": {
                  "title": "Quiet switch",
                  "type": "boolean",
                  "default": true
                },
                "sleep": {
                  "title": "Sleep switch",
                  "type": "boolean",
                  "default": false
                },
                "smart": {
                  "title": "Smart switch",
                  "type": "boolean",
                  "default": false
                },
                "comfort": {
                  "title": "Comfort switch",
                  "type": "boolean",
                  "default": false
                },
                "twoStep": {
                  "title": "2-Step switch",
                  "type": "boolean",
                  "default": false
                },
                "motionDirect": {
                  "title": "Wind follows people switch",
                  "type": "boolean",
                  "default": false
                },
                "motionIndirect": {
                  "title": "Wind avoids people switch",
                  "type": "boolean",
                  "default": false
                },
                "light": {
                  "title": "Light Display",
                  "type": "boolean",
                  "default": true
                },
                "beep": {
                  "title": "Beep switch",
                  "type": "boolean",
                  "default": false
                },
                "autoClean": {
                  "title": "Auto Clean switch",
                  "type": "boolean",
                  "default": false
                },
                "humidity": {
                  "title": "Humidity sensor",
                  "type": "boolean",
                  "default": true
                },
                "filter": {
                  "title": "Filter status",
                  "type": "boolean",
                  "default": true
                },
                "outdoorTemperature": {
                  "title": "Outdoor temperature sensor (derived, unverified)",
                  "type": "boolean",
                  "default": false
                },
                "energyEve": {
                  "title": "Power and energy for Eve-compatible apps",
                  "type": "boolean",
                  "default": true
                },
                "cycleTile": {
                  "title": "Laundry: cycle tile with time remaining",
                  "type": "boolean",
                  "default": true
                },
                "finishedSensor": {
                  "title": "Laundry: cycle finished sensor",
                  "type": "boolean",
                  "default": true
                },
                "unloadSensor": {
                  "title": "Laundry: unload reminder, every half hour while the washing stays inside",
                  "type": "boolean",
                  "default": false
                },
                "stageSensors": {
                  "title": "Laundry (trial): a sensor for each stage the washer names (washing, rinsing, spinning)",
                  "type": "boolean",
                  "default": true
                },
                "drumCleanSensor": {
                  "title": "Laundry (trial): drum clean sensor",
                  "type": "boolean",
                  "default": true
                },
                "progressTile": {
                  "title": "Laundry: progress tile (percent)",
                  "type": "boolean",
                  "default": false
                },
                "kidsLockSensor": {
                  "title": "Laundry: child lock status",
                  "type": "boolean",
                  "default": false
                },
                "alertSensor": {
                  "title": "Laundry: alert sensor (appliance faults)",
                  "type": "boolean",
                  "default": false
                },
                "ctlPower": {
                  "title": "Laundry control (trial, models differ): power switch (on/off)",
                  "type": "boolean",
                  "default": false
                },
                "ctlRun": {
                  "title": "Laundry control (trial, models differ): run switch (start or resume, pause)",
                  "type": "boolean",
                  "default": false
                },
                "ctlStop": {
                  "title": "Laundry control (trial, models differ): stop the cycle",
                  "type": "boolean",
                  "default": false
                },
                "ctlKidsLock": {
                  "title": "Laundry control (trial, models differ): child lock that can be set",
                  "type": "boolean",
                  "default": false
                },
                "ctlBuzzer": {
                  "title": "Laundry control (trial, models differ): sound switch",
                  "type": "boolean",
                  "default": false
                },
                "ctlSpin": {
                  "title": "Laundry control (trial, models differ): spin level, a group of switches",
                  "type": "boolean",
                  "default": false
                },
                "ctlRinse": {
                  "title": "Laundry control (trial, models differ): rinse count, a group of switches",
                  "type": "boolean",
                  "default": false
                },
                "ctlWaterTemp": {
                  "title": "Laundry control (trial, models differ): water temperature, a group of switches",
                  "type": "boolean",
                  "default": false
                },
                "ctlWaterLevel": {
                  "title": "Laundry control (trial, models differ): water level, a group of switches",
                  "type": "boolean",
                  "default": false
                },
                "ctlWashTime": {
                  "title": "Laundry control (trial, models differ): wash time, a group of switches",
                  "type": "boolean",
                  "default": false
                },
                "ctlCourse": {
                  "title": "Laundry control (trial, models differ): course, next number",
                  "type": "boolean",
                  "default": false
                },
                "ctlSuperSpeed": {
                  "title": "Laundry control (trial, models differ): Super Speed switch",
                  "type": "boolean",
                  "default": false
                },
                "ctlBubbleSoak": {
                  "title": "Laundry control (trial, models differ): Bubble Soak switch",
                  "type": "boolean",
                  "default": false
                },
                "ctlBubbleStorm": {
                  "title": "Laundry control (trial, models differ): Eco Bubble switch",
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "type": {
              "title": "Appliance type",
              "type": "string",
              "description": "Set by the plugin settings page. \"tv\" for a Samsung TV; leave empty for other appliances."
            },
            "tvMode": {
              "title": "How a TV appears in Apple Home",
              "type": "string",
              "default": "tile",
              "oneOf": [
                {
                  "title": "TV tile with remote (added to the Home app on its own)",
                  "enum": [
                    "tile"
                  ]
                },
                {
                  "title": "Switches inside the bridge (power, mute, volume)",
                  "enum": [
                    "switches"
                  ]
                }
              ]
            },
            "tvSwitches": {
              "title": "Switches for automations",
              "type": "array",
              "uniqueItems": true,
              "description": "Switches of this TV shown in Apple Home as one group, for automations and scenes. Independent of the remote.",
              "items": {
                "type": "string",
                "enum": ["power", "mute", "volumeUp", "volumeDown", "channelUp", "channelDown", "playPause", "home"]
              }
            },
            "appleRemote": {
              "title": "iPhone remote with keyboard (trial)",
              "type": "boolean",
              "default": false,
              "description": "Shows this TV to the iPhone's own remote in Control Centre as an Apple TV, so the iPhone keyboard can type into the TV. Unofficial and may stop working after an iOS update."
            },
            "appleRemoteTouch": {
              "title": "Touch area of the iPhone remote",
              "type": "string",
              "default": "arrows",
              "oneOf": [
                { "title": "Arrows: a slide moves the selection step by step", "enum": ["arrows"] },
                { "title": "Pointer (trial): the finger moves a pointer, like a mouse", "enum": ["pointer"] }
              ],
              "description": "The pointer shows in the TV's browser and in some apps; elsewhere nothing moves."
            },
            "appleRemotePin": {
              "title": "Pairing code of the iPhone remote",
              "type": "string",
              "pattern": "^[0-9]{4}$",
              "placeholder": "0000",
              "description": "Four digits a new iPhone or iPad enters once. Empty means 0000. Anyone on your network who knows it can pair, so choose your own digits if others use the network."
            },
            "model": {
              "title": "Model",
              "type": "string"
            },
            "cycleStyle": {
              "title": "Laundry: how the cycle tile behaves",
              "type": "string",
              "default": "valve",
              "oneOf": [
                {
                  "title": "Tile with countdown (a tap is undone at once)",
                  "enum": [
                    "valve"
                  ]
                },
                {
                  "title": "Running sensor (no countdown, never reacts to a tap)",
                  "enum": [
                    "sensor"
                  ]
                }
              ]
            }
          }
        }
      },
      "pollInterval": {
        "title": "Polling interval (seconds)",
        "type": "integer",
        "default": 5,
        "minimum": 4,
        "maximum": 300,
        "description": "How often the appliance is read when it sends no push update. Changes made with the remote show up within this time. Minimum 4: one reading takes one to two seconds, and a command waits behind a reading in progress. A lower saved value is used as 4."
      },
      "pushUpdates": {
        "title": "Use push updates when the appliance supports them",
        "type": "boolean",
        "default": true
      },
      "followAddress": {
        "title": "Find an appliance again when its address changes",
        "type": "boolean",
        "default": true,
        "description": "When an appliance stops answering, the plugin asks every address of the home network (/24) where it went, at most once every five minutes. Nothing leaves your network."
      },
      "engine": {
        "title": "Connection engine",
        "type": "string",
        "description": "Both give the same features. The JavaScript engine (newer) needs no Python. Leave empty for the default of the installed version.",
        "oneOf": [
          {
            "title": "Python (stable)",
            "enum": [
              "python"
            ]
          },
          {
            "title": "JavaScript (newer, no Python needed)",
            "enum": [
              "javascript"
            ]
          }
        ]
      },
      "pythonPath": {
        "title": "Python interpreter (optional)",
        "type": "string",
        "placeholder": "python3",
        "description": "Only needed when the default python3 is older than 3.11."
      }
    }
  }
}
